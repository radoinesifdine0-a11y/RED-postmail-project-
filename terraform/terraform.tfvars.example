# ============================================
# Terraform Variables Example
# ============================================
# Copy this file to terraform.tfvars and fill in your values
# DO NOT COMMIT terraform.tfvars to version control!

# ============================================
# GCP Configuration
# ============================================
gcp_project_id = "store-parcels-training"
gcp_region     = "europe-west1"

# ============================================
# MongoDB Atlas Configuration
# ============================================
# Get these from Atlas: Organization Settings > Access Manager > API Keys
atlas_public_key  = "your-atlas-public-key"
atlas_private_key = "your-atlas-private-key"

# Get this from Atlas: Organization Settings
atlas_org_id = "your-atlas-org-id"

# Strong password for MongoDB database user
mongodb_password = "your-secure-password-here"

# ============================================
# Application Configuration
# ============================================
app_name      = "store-parcels"
app_image_tag = "latest"
