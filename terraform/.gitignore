# ============================================
# Terraform .gitignore
# ============================================

# Terraform state files (contain sensitive data)
*.tfstate
*.tfstate.backup
*.tfstate.*

# Terraform variables file (contains secrets)
terraform.tfvars
*.auto.tfvars

# Terraform directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Plan files
*.tfplan
tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Secret files
*.pem
*.key
*.json

# Backup files
*.backup
*.bak

# IDE files
.idea/
*.iml
.vscode/
